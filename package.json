{"name":"memoryblox","private":true,"description":"Browser-based MEMORYBLOX remake built with TypeScript, HTML, and CSS.","scripts":{"lint":"eslint .","typecheck":"tsc --noEmit","artifacts":"npm run audio:index && npm run icons:sync","validate":"npm run artifacts && markdownlint-cli2 && npm run lint && npm run typecheck","test":"vitest run","test:coverage":"vitest run --coverage","test:watch":"vitest","test:e2e":"npx playwright test","fallow":"fallow","fallow:audit":"fallow audit","fallow:health":"fallow health --score","quality:sanity":"npm run validate && npm run fallow && npm run test","quality:full":"npm run validate && npm run fallow && npm run test && npm run test:e2e","audio:index":"node ./tools/generate-audio-indexes.mjs","icons:sync":"node ./tools/sync-icon-artifacts.mjs","icons:generate-packs":"tsx ./tools/generate-icon-packs.ts --config ./config/icon-pack-generator.json","leaderboard:server":"node ./tools/leaderboard-server.mjs","serve:dev-root":"vite --port 8080","dev":"concurrently -n Vite,Leaderboard -c blue,magenta \"vite\" \"npm run leaderboard:server\"","dev:full":"npm run dev","serve":"concurrently -k -n Vite,Leaderboard -c green,magenta \"vite preview --port 8080\" \"npm run leaderboard:server\"","build":"npm run artifacts && vite build"},"devDependencies":{"@eslint/js":"^10.0.1","@playwright/test":"^1.61.1","@tailwindcss/vite":"^4.3.2","@types/jsdom":"^28.0.3","@types/node":"^26.1.0","@vitest/coverage-istanbul":"^4.1.9","better-sqlite3":"^12.11.1","concurrently":"^10.0.3","daisyui":"^5.6.13","eslint":"^10.6.0","fallow":"^3.0.0","globals":"^17.7.0","jsdom":"^29.0.2","markdownlint-cli2":"^0.22.1","tailwindcss":"^4.2.2","tsx":"^4.23.0","typescript":"^6.0.3","typescript-eslint":"^8.62.1","vite":"^8.1.3","vitest":"^4.1.4"},"overrides":{"minimatch":"^10.2.1"},"engines":{"node":">=18.0.0"}}
